#!/usr/bin/env bash
# Command-line launcher for VoxelFit.jl.
#
#   bin/voxelfit fit --model MonoExp --x 10,20,30,40 --data echoes.nii.gz --out maps/sub01
#   bin/voxelfit help
#
# Environment variables:
#   JULIA               julia executable (default: julia on PATH)
#   VOXELFIT_THREADS    CPU threads (default: auto)
#   VOXELFIT_PROJECT    Julia project to run in (default: this package). Use a project that
#                       also contains CUDA/AMDGPU/Metal for --backend gpu runs.
#   VOXELFIT_SYSIMAGE   optional system image from build/build_sysimage.jl (near-instant start)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
root="$(cd "$here/.." && pwd -P)"
julia="${JULIA:-julia}"
args=(--startup-file=no --threads="${VOXELFIT_THREADS:-auto}" --project="${VOXELFIT_PROJECT:-$root}")
if [[ -n "${VOXELFIT_SYSIMAGE:-}" ]]; then
    args+=(--sysimage="$VOXELFIT_SYSIMAGE")
fi
exec "$julia" "${args[@]}" -e 'using VoxelFit; exit(VoxelFit.main(ARGS))' -- "$@"
